# Loaded ONLY by `npm run dev` (vite mode=development), overriding .env.
# Keeps local development pointed at the local API server, so a dev session
# never silently talks to the deployed backend — which is what produced
# "Unexpected token '<'" (Render 404 HTML) before the ladder was deployed.
#
# `npm run build` ignores this file and uses .env, so production still points
# at nukko.onrender.com.
VITE_API_URL=http://localhost:3001
