# Loaded ONLY by `npm run dev` (vite mode=development) and it OVERRIDES .env —
# so editing VITE_API_URL in .env has no effect on a dev session.
#
# Empty means "same origin": the app calls /api/... and vite.config.js proxies
# it to the API server (default http://localhost:3001). That is what makes the
# ngrok tunnel work — a phone cannot reach your Mac's localhost.
#
# To point a dev session at the deployed backend instead, do not edit this file:
#   API_PROXY_TARGET=https://nukko.onrender.com npm run dev
#
# `npm run build` ignores this file and uses .env (nukko.onrender.com).
VITE_API_URL=
